# Slack request verification
SLACK_SIGNING_SECRET=

# Local, single-workspace development
SLACK_BOT_TOKEN=

# OAuth distribution (optional for local development)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=

# Runtime
# Replace CHANGE_ME. Compose reads POSTGRES_PASSWORD for the database container.
# The sample DATABASE_URL uses the Compose hostname `postgres` and the same placeholder.
# Postgres is not published on the host. Point DATABASE_URL at another host if the
# app process runs outside Compose.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://teamloop:CHANGE_ME@postgres:5432/teamloop?schema=public
APP_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DEFAULT_TIMEZONE=UTC
